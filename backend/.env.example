# Optional session security; replace before any shared/public deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Gemini API (OpenAI-compatible endpoint). Create a key in Google AI Studio.
# This is a free-tier model default; the key must belong to a project without billing enabled
# to prevent paid usage. Do not commit backend/.env.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash-lite
COOKIE_SECURE=0
